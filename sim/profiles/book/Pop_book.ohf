// set mining / flat multiway (p179: play pots with bad players): 22-JJ A2s+ KTs+ QTs+ JTs T9s 98s 87s 76s 65s AQo
65s 76s 87s 98s A2s A3s A4s A5s A6s A7s A8s A9s AJs AKs AQo AQs ATs JTs KJs KQs KTs QJs QTs T9s

##list21##
// shove vs a 4bet: KK+
AA KK

##list22##
// 4bet vs a loose 3bettor: QQ+ AKs AKo A5s
A5s AA AKo AKs KK QQ

// ---------- positions relative to the button (valid with 2..6 players dealt)
##f$PosBTN##
(dealposition = nplayersdealt AND nplayersdealt >= 3)
##f$PosCO##
(dealposition = nplayersdealt - 1 AND nplayersdealt >= 4)
##f$PosHJ##
(dealposition = nplayersdealt - 2 AND nplayersdealt >= 5)
##f$PosEarly##
(dealposition <= nplayersdealt - 3 AND dealposition >= 3)
##f$InPositionPreflop##
// we will act after the opener postflop: later seat than the raiser and not a blind
(NOT InSmallBlind AND NOT InBigBlind AND (Raises = 0 OR dealposition > DealPositionLastRaiser))
##f$OpenerLate##
// late opener = CO, BTN or SB (wide steal ranges)
(DealPositionLastRaiser >= nplayersdealt - 1 OR DealPositionLastRaiser = 1)
##f$OpenSize##
// last raise level in big blinds (what we face)
(AmountToCall + currentbet / bblind)

// ---------- opponent profiling with stats (p49-61), only with enough hands
##f$BlindsFoldToSteals##
// p37: both blinds fold to steals >= ~75% -> open very wide
(pt_hands_bigblindchair >= 40 AND pt_bb_fold_to_steal_bigblindchair >= 0.75)
##f$BBFoldsVsSB##
(pt_hands_bigblindchair >= 40 AND pt_bb_fold_to_steal_bigblindchair >= 0.65)
##f$LooseThreeBettor##
(pt_hands_raischair >= 100 AND pt_3bet_raischair >= 0.09)
##f$VillainStation##
// calling station: goes to showdown a lot (p43-45)
(OpponentsLeft = 1 AND pt_hands_headsupchair >= 50 AND pt_wtsd_headsupchair >= 0.32)
##f$VillainFitOrFold##
// fit-or-fold: folds to c-bets often (p40-41)
(OpponentsLeft = 1 AND pt_hands_headsupchair >= 50 AND pt_flop_fold_to_cbet_headsupchair >= 0.55)
##f$VillainPassive##
// passive player: a raise from him means a strong hand (p159-174)
(pt_hands_headsupchair >= 50 AND pt_total_af_headsupchair >= 0 AND pt_total_af_headsupchair < 1.3)

// ---------- hand classes
##f$Monster##
(HaveSet OR HaveTopTwoPair OR HaveStraight OR HaveFlush OR HaveFullHouse OR HaveQuads OR HaveStraightFlush OR (HaveTwoPair AND NOT PairOnBoard))
##f$StrongPair##
(HaveOverPair OR (HaveTopPair AND HaveSecondBestKickerOrBetter))
##f$WeakTopPair##
(HaveTopPair AND NOT f$StrongPair)
##f$MediumPair##
(HaveSecondTopPair OR (HavePair AND NOT HaveTopPair AND NOT HaveOverPair))
##f$StrongDraw##
(HaveFlushDraw OR HaveOpenEndedStraightDraw OR HaveDoubleGutshotDraw)
##f$WeakDraw##
(HaveInsideStraightDraw OR HaveBackdoorFlushDraw)
##f$DryBoard##
(NOT PairOnBoard AND NOT FlushPossible AND NOT StraightPossible)
##f$Spr##
(StackSize / (PotSize + 0.01))
##f$PFA##
// we were the last preflop raiser
(BotsLastPreflopAction = Raise)

##f$InPositionPostflop##
// we act last postflop. Postflop order follows dealposition (SB = 1 first, button last);
// heads-up tables: the small blind is the button and acts last.
((nplayersdealt = 2 AND InSmallBlind) OR (nplayersdealt >= 3 AND f$PosBTN) OR (nplayersdealt >= 3 AND OpponentsLeft = 1 AND dealposition > f$OppDealPos))
##f$OppDealPos##
// dealposition of the (first) opponent still in the hand
WHEN userchair != 0 AND (playersplayingbits bitand 1) != 0 RETURN ac_dealpos0 FORCE
WHEN userchair != 1 AND (playersplayingbits bitand 2) != 0 RETURN ac_dealpos1 FORCE
WHEN userchair != 2 AND (playersplayingbits bitand 4) != 0 RETURN ac_dealpos2 FORCE
WHEN userchair != 3 AND (playersplayingbits bitand 8) != 0 RETURN ac_dealpos3 FORCE
WHEN userchair != 4 AND (playersplayingbits bitand 16) != 0 RETURN ac_dealpos4 FORCE
WHEN userchair != 5 AND (playersplayingbits bitand 32) != 0 RETURN ac_dealpos5 FORCE
WHEN userchair != 6 AND (playersplayingbits bitand 64) != 0 RETURN ac_dealpos6 FORCE
WHEN userchair != 7 AND (playersplayingbits bitand 128) != 0 RETURN ac_dealpos7 FORCE
WHEN userchair != 8 AND (playersplayingbits bitand 256) != 0 RETURN ac_dealpos8 FORCE
WHEN userchair != 9 AND (playersplayingbits bitand 512) != 0 RETURN ac_dealpos9 FORCE
WHEN Others RETURN 0 FORCE


preflop

// ===== preflop (book: steal wide in late position, tight early, extra tight vs raises, 3bet for value)
// --- short stacks facing all-in or very large bets
WHEN AmountToCall >= 25 AND list21 Call FORCE
WHEN AmountToCall >= 25 AND AmountToCall <= 40 AND hand$QQ Call FORCE
WHEN AmountToCall >= 25 Fold FORCE

// --- first in (no limpers): one open size, 3bb (p40)
WHEN Raises = 0 AND Calls = 0 AND NOT InBigBlind
    WHEN f$PosEarly AND dealposition = nplayersdealt - 3 AND list1 RaiseTo 3 FORCE
    WHEN f$PosEarly AND dealposition = nplayersdealt - 3 Fold FORCE
    WHEN f$PosEarly AND list1 RaiseTo 3 FORCE
    WHEN f$PosHJ AND list2 RaiseTo 3 FORCE
    WHEN f$PosCO AND list3 RaiseTo 3 FORCE
    WHEN f$PosBTN AND f$BlindsFoldToSteals AND list5 RaiseTo 3 FORCE
    WHEN f$PosBTN AND list4 RaiseTo 3 FORCE
    WHEN InSmallBlind AND nplayersdealt = 2 AND list5 RaiseTo 2.5 FORCE
    WHEN InSmallBlind AND f$BBFoldsVsSB AND list5 RaiseTo 3 FORCE
    WHEN InSmallBlind AND list3 RaiseTo 3 FORCE
    WHEN Others Fold FORCE

// --- limpers in front, nobody raised: isolate (p151), never limp behind
WHEN Raises = 0 AND Calls >= 1
    WHEN InBigBlind AND list18 RaiseTo (4 + Calls) FORCE
    WHEN InBigBlind Check FORCE
    WHEN f$InPositionPreflop AND list17 RaiseTo (4 + Calls) FORCE
    WHEN list18 RaiseTo (4 + Calls) FORCE
    WHEN Others Fold FORCE

// --- facing one open raise, we have not acted yet
WHEN Raises = 1 AND currentbet <= bblind
    // value 3bet: ~3x in position, ~3.3x out of position (p176, p187)
    WHEN list6 AND f$InPositionPreflop RaiseTo (f$OpenSize * 3) FORCE
    WHEN list6 RaiseTo (f$OpenSize * 3.3 + Calls * f$OpenSize) FORCE
    WHEN f$OpenerLate AND list7 AND Calls = 0 AND f$InPositionPreflop RaiseTo (f$OpenSize * 3) FORCE
    WHEN f$OpenerLate AND list7 AND Calls = 0 RaiseTo (f$OpenSize * 3.3) FORCE
    // punish loose late opens from the blinds and the button (p187), mixed
    WHEN f$OpenerLate AND Calls = 0 AND (InSmallBlind OR InBigBlind OR f$PosBTN OR f$PosCO) AND list8 AND randomheartbeat < 0.85 RaiseTo (f$OpenSize * 3.3) FORCE
    WHEN NOT f$OpenerLate AND Calls = 0 AND (hand$JJ OR hand$AQs) AND f$InPositionPreflop RaiseTo (f$OpenSize * 3) FORCE
    WHEN NOT f$OpenerLate AND Calls = 0 AND f$PosBTN AND list8 AND randomheartbeat < 0.3 RaiseTo (f$OpenSize * 3) FORCE
    // multiway (callers already in): set mining in position with deep stacks
    WHEN Calls >= 1 AND f$InPositionPreflop AND list20 AND StackSize >= 20 * AmountToCall Call FORCE
    WHEN Calls >= 1 AND InBigBlind AND list20 AND StackSize >= 20 * AmountToCall Call FORCE
    WHEN Calls >= 1 Fold FORCE
    // heads-up so far: call in position, defend the big blind
    WHEN f$InPositionPreflop AND f$OpenerLate AND list9 Call FORCE
    WHEN f$InPositionPreflop AND list10 Call FORCE
    WHEN InBigBlind AND f$OpenerLate AND list11 AND AmountToCall <= 3 Call FORCE
    WHEN InBigBlind AND list12 AND AmountToCall <= 3 Call FORCE
    WHEN InSmallBlind AND f$OpenerLate AND list13 Call FORCE
    WHEN Others Fold FORCE

// NOTE: OpenPPL "Raises" counts the raises since OUR last action. After we open, a 3bet reads Raises = 1.
// So nodes are told apart by the money we already put in (currentbet, in big blinds).
// --- we opened / isolated (<= 6bb in) and got re-raised (p176, p188)
WHEN AmountToCall > 0 AND currentbet > bblind AND currentbet <= 6 * bblind
    WHEN list14 RaiseTo (f$OpenSize * 2.3) FORCE
    WHEN f$LooseThreeBettor AND list22 RaiseTo (f$OpenSize * 2.3) FORCE
    WHEN f$InPositionPreflop AND list15 AND StackSize >= 12 * AmountToCall Call FORCE
    WHEN (hand$A5s OR hand$A4s) AND randomheartbeat < 0.3 RaiseTo (f$OpenSize * 2.3) FORCE
    WHEN list16 Call FORCE
    WHEN Others Fold FORCE

// --- we 3bet (or more) and face a 4bet: get it in with the top (p178: usually fold TT to a 4bet)
WHEN AmountToCall > 0 AND currentbet > 6 * bblind
    WHEN list21 RaiseMax FORCE
    WHEN f$LooseThreeBettor AND (hand$QQ OR hand$AKs OR hand$AKo) RaiseMax FORCE
    WHEN Others Fold FORCE

// --- facing a 3bet cold (we have not put money in beyond the blind)
WHEN Raises = 2
    WHEN list14 RaiseTo (f$OpenSize * 2.3) FORCE
    WHEN hand$QQ OR hand$AKs Call FORCE
    WHEN Others Fold FORCE

// --- facing a 4bet cold
WHEN Raises >= 3
    WHEN list21 RaiseMax FORCE
    WHEN Others Fold FORCE

WHEN Others Fold FORCE


flop

// ===== flop
// --- nobody bet yet (we act first, or it was checked to us)
WHEN AmountToCall = 0
    // big hands deserve big pots, no slowplay (p217-220)
    WHEN f$Monster RaiseBy 75% FORCE
    // multiway: straightforward, value-heavy (p179)
    WHEN OpponentsLeft >= 2 AND f$StrongPair RaiseBy 66% FORCE
    WHEN OpponentsLeft >= 2 AND f$StrongDraw AND f$InPositionPostflop RaiseBy 66% FORCE
    WHEN OpponentsLeft >= 2 Check FORCE
    // heads-up as preflop raiser: c-bet (fit-or-fold opponents lose to aggression, p41)
    WHEN f$PFA AND f$StrongPair RaiseBy 66% FORCE
    WHEN f$PFA AND f$WeakTopPair RaiseBy 50% FORCE
    WHEN f$PFA AND f$StrongDraw RaiseBy 66% FORCE
    WHEN f$PFA AND f$MediumPair AND f$DryBoard RaiseBy 50% FORCE
    WHEN f$PFA AND f$MediumPair Check FORCE
    WHEN f$PFA AND f$VillainStation Check FORCE
    WHEN f$PFA AND f$VillainFitOrFold RaiseBy 50% FORCE
    WHEN f$PFA AND f$DryBoard AND randomheartbeat < 0.85 RaiseBy 50% FORCE
    WHEN f$PFA AND randomheartbeat < 0.55 RaiseBy 50% FORCE
    // not the preflop raiser and checked to: small-ball stab in position (p221)
    WHEN NOT f$PFA AND f$InPositionPostflop AND (f$StrongPair OR f$WeakTopPair OR f$StrongDraw) RaiseBy 66% FORCE
    WHEN NOT f$PFA AND f$InPositionPostflop AND NOT f$VillainStation AND randomheartbeat < 0.5 RaiseBy 50% FORCE
    WHEN Others Check FORCE

// --- facing a raise after we bet
WHEN AmountToCall > 0 AND currentbet > 0
    WHEN f$Monster RaiseMax FORCE
    // commit with a strong pair only at low SPR (p187); passive raiser = strong hand (p159-174)
    WHEN f$StrongPair AND f$VillainPassive Fold FORCE
    WHEN f$StrongPair AND f$Spr <= 3 RaiseMax FORCE
    WHEN f$StrongPair AND AmountToCall <= 0.35 * StackSize Call FORCE
    WHEN f$StrongDraw AND AmountToCall <= 0.5 * PotSize Call FORCE
    WHEN Others Fold FORCE

// --- facing a bet
WHEN AmountToCall > 0
    WHEN f$Monster RaisePot FORCE
    WHEN f$StrongPair Call FORCE
    WHEN OpponentsLeft >= 2 AND f$StrongDraw AND AmountToCall <= 0.5 * PotSize Call FORCE
    WHEN OpponentsLeft >= 2 Fold FORCE
    WHEN f$WeakTopPair AND AmountToCall <= PotSize Call FORCE
    // out of position, semibluff only with a strong draw when (nearly) all-in (p222)
    WHEN f$StrongDraw AND NOT f$InPositionPostflop AND f$Spr <= 3 RaiseMax FORCE
    WHEN f$StrongDraw AND AmountToCall <= 0.6 * PotSize Call FORCE
    WHEN (f$MediumPair OR HavePair) AND AmountToCall <= 0.8 * PotSize AND NOT f$VillainPassive Call FORCE
    // float in position vs a c-bet (p177), then take it away on the turn
    WHEN f$InPositionPostflop AND (f$WeakDraw OR Overcards >= 2) AND AmountToCall <= 0.7 * PotSize AND randomheartbeat < 0.5 Call FORCE
    WHEN Others Fold FORCE


turn

// ===== turn
WHEN AmountToCall = 0
    WHEN f$Monster RaiseBy 75% FORCE
    WHEN OpponentsLeft >= 2 AND f$StrongPair RaiseBy 66% FORCE
    WHEN OpponentsLeft >= 2 Check FORCE
    // value: two-three modest bets with top pair, pot control vs aggressive players (p213-216)
    WHEN f$StrongPair AND pt_hands_headsupchair >= 50 AND pt_total_af_headsupchair >= 3 Check FORCE
    WHEN f$StrongPair RaiseBy 66% FORCE
    WHEN f$WeakTopPair AND f$VillainStation RaiseBy 50% FORCE
    WHEN f$WeakTopPair Check FORCE
    WHEN f$StrongDraw AND (BotsLastFlopAction = Raise OR f$InPositionPostflop) RaiseBy 66% FORCE
    // barreling: second barrel on scare cards, give up on blanks (p62-92)
    WHEN f$PFA AND BotsLastFlopAction = Raise AND NOT f$VillainStation AND (TurnCardIsOvercardToBoard OR AcePresentOnTurn) RaiseBy 75% FORCE
    WHEN f$PFA AND BotsLastFlopAction = Raise AND f$VillainFitOrFold AND randomheartbeat < 0.5 RaiseBy 66% FORCE
    // floated the flop in position and it is checked to us: take it away (p177)
    WHEN NOT f$PFA AND f$InPositionPostflop AND BotsLastFlopAction = Call AND NOT f$VillainStation RaiseBy 66% FORCE
    WHEN Others Check FORCE

WHEN AmountToCall > 0 AND currentbet > 0
    WHEN f$Monster RaiseMax FORCE
    WHEN f$StrongPair AND f$VillainPassive Fold FORCE
    WHEN f$StrongPair AND f$Spr <= 2 Call FORCE
    WHEN f$StrongDraw AND AmountToCall <= 0.3 * PotSize Call FORCE
    WHEN Others Fold FORCE

WHEN AmountToCall > 0
    WHEN f$Monster RaisePot FORCE
    WHEN f$StrongPair AND f$VillainPassive AND AmountToCall > 0.7 * PotSize Fold FORCE
    WHEN f$StrongPair AND AmountToCall <= PotSize Call FORCE
    WHEN OpponentsLeft >= 2 Fold FORCE
    WHEN f$WeakTopPair AND AmountToCall <= PotSize AND NOT f$VillainPassive Call FORCE
    WHEN f$MediumPair AND AmountToCall <= 0.6 * PotSize AND NOT f$VillainPassive Call FORCE
    WHEN f$StrongDraw AND AmountToCall <= 0.5 * PotSize Call FORCE
    WHEN Others Fold FORCE


river

// ===== river
WHEN AmountToCall = 0
    WHEN f$Monster AND f$VillainStation RaisePot FORCE
    WHEN f$Monster RaiseBy 75% FORCE
    WHEN OpponentsLeft >= 2 AND f$StrongPair RaiseBy 50% FORCE
    WHEN OpponentsLeft >= 2 Check FORCE
    // thin value vs loose-passive / stations, small size (p215)
    WHEN f$StrongPair AND (f$VillainStation OR f$InPositionPostflop) RaiseBy 50% FORCE
    WHEN f$WeakTopPair AND f$VillainStation RaiseBy 40% FORCE
    // rare third barrel: missed draws in position vs non-stations, big enough to work (p222-223)
    WHEN f$InPositionPostflop AND BotsLastTurnAction = Raise AND NOT f$VillainStation AND NOT HavePair AND randomheartbeat < 0.3 RaiseBy 75% FORCE
    WHEN Others Check FORCE

WHEN AmountToCall > 0 AND currentbet > 0
    WHEN HaveNuts Call FORCE
    WHEN f$Monster AND NOT f$VillainPassive Call FORCE
    WHEN Others Fold FORCE

WHEN AmountToCall > 0
    WHEN HaveNuts RaisePot FORCE
    WHEN f$Monster Call FORCE
    WHEN f$StrongPair AND f$VillainPassive AND AmountToCall > 0.6 * PotSize Fold FORCE
    WHEN f$StrongPair AND AmountToCall <= PotSize Call FORCE
    WHEN f$WeakTopPair AND AmountToCall <= PotSize AND NOT f$VillainPassive Call FORCE
    WHEN f$MediumPair AND AmountToCall <= 0.5 * PotSize AND NOT f$VillainPassive Call FORCE
    WHEN Others Fold FORCE

