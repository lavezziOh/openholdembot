//*****************************************************************************
//
// OpenPPL - Position Symbols
//
//*****************************************************************************

// Standard PPL accepts two spellings for the position symbols
// "In BigBlind" and "InBigBlind", "In Button" and "InButton", ...
// Our parser is able to ignore the fillerword "In ",
// but to be more user-friendly and to simplify the converter (less error-handling)
// we decided to provide both forms of naming in the library.

##SmallBlind##
WHEN (userchair < 0) RETURN false FORCE
WHEN (userchair == smallblindchair) RETURN true FORCE

##BigBlind##
WHEN (userchair < 0) RETURN false FORCE
WHEN (userchair == bigblindchair) RETURN true FORCE

##Button##
// If the game in not 10-handed, some positions would be both "normal" and in the blinds.
// E.g. for a 9-handed game big-blind would also be counted as EarlyPosition1.
// Therefore we check for "Not InTheBlinds", except for button,
// because "InButton" makes sense even if the game is headsup.
(dealposition == nplayersdealt)

##CutOff##
[(dealposition == nplayersdealt - 1) AND NOT InTheBlinds]

##MiddlePosition3##
[(dealposition == nplayersdealt - 2) AND NOT InTheBlinds]

##MiddlePosition2##
[(dealposition == nplayersdealt - 3) AND NOT InTheBlinds]

##MiddlePosition1##
[(dealposition == nplayersdealt - 4) AND NOT InTheBlinds]

##EarlyPosition3##
[(dealposition == nplayersdealt - 5) AND NOT InTheBlinds]

##EarlyPosition2##
[(dealposition == nplayersdealt - 6) AND NOT InTheBlinds]

##EarlyPosition1##
[(dealposition == nplayersdealt - 7) AND NOT InTheBlinds]

##UTG##
// Under the gun - first to act preflop, 
// independent of the players at the table (at least 3).
// This symbols is especially useful to sitout 
// after the last hand of a session (before the next blind).
WHEN (userchair < 0) RETURN false FORCE
WHEN (userchair == utgchair) RETURN true FORCE

##InSmallBlind##
SmallBlind

##InBigBlind##
BigBlind

##TheBlinds##
// To be used: In TheBlinds
InTheBlinds

##InTheBlinds##
(InSmallBlind OR InBigBlind)

##EarlyPosition##
InEarlyPosition

##InEarlyPosition##
(InEarlyPosition1 OR InEarlyPosition2 OR InEarlyPosition3)

##MiddlePosition##
InMiddlePosition

##InMiddlePosition##
(InMiddlePosition1 OR InMiddlePosition2 OR InMiddlePosition3)

##LatePosition##
InLatePosition

##InLatePosition##
(InCutOff OR InButton)

##InButton##
Button

##InCutOff##
CutOff

##InMiddlePosition3##
MiddlePosition3

##InMiddlePosition2##
MiddlePosition2

##InMiddlePosition1##
MiddlePosition1

##InEarlyPosition3##
EarlyPosition3

##InEarlyPosition2##
EarlyPosition2

##InEarlyPosition1##
EarlyPosition1

##InUTG##
UTG

##First##
0

##Middle##
1

##Last##
2

##Position##
(betposition == 1) ? First :
(betposition == nplayersplaying) ? Last :
Middle

##FirstCallerPosition##
// Searching from the early positions: the first caller of the first orbit preflop
// (callers that did not raise preflop; the open raiser calling a 3-bet is no "first caller").
EarlyPosition1ColdCalling ? 9 :
EarlyPosition2ColdCalling ? 8 :
EarlyPosition3ColdCalling ? 7 :
MiddlePosition1ColdCalling ? 6 :
MiddlePosition2ColdCalling ? 5 :
MiddlePosition3ColdCalling ? 4 :
CutOffColdCalling ? 3 :
ButtonColdCalling ? 2 :
SmallBlindColdCalling ? 1 :
BigBlindColdCalling ? 0 :
HINT_No_FirstCaller

##FirstRaiserPosition##
// We have to search starting from early positions,
// as we want to detect the first one.
EarlyPosition1Raising  ? 9 :
EarlyPosition2Raising  ? 8 :
EarlyPosition3Raising  ? 7 :
MiddlePosition1Raising ? 6 :
MiddlePosition2Raising ? 5 :
MiddlePosition3Raising ? 4 :
CutOffRaising          ? 3 :
ButtonRaising          ? 2 :
SmallBlindRaising ? 1 :
// The big blind raises first in a limped pot (it was missing: no raiser found)
BigBlindRaising   ? 0 :
HINT_No_FirstRaiser

##LastCallerPosition##
// Searching from the late positions (the big blind acts last): the last caller of the first orbit
BigBlindColdCalling ? 0 :
SmallBlindColdCalling ? 1 :
ButtonColdCalling ? 2 :
CutOffColdCalling ? 3 :
MiddlePosition3ColdCalling ? 4 :
MiddlePosition2ColdCalling ? 5 :
MiddlePosition1ColdCalling ? 6 :
EarlyPosition3ColdCalling ? 7 :
EarlyPosition2ColdCalling ? 8 :
EarlyPosition1ColdCalling ? 9 :
HINT_No_LastCaller

##LastRaiserPosition##
// Handling the case of blind-raisers only first
[IsPreflop AND (ncallbets <= 1)] ? HINT_There_Are_No_true_Raisers :
// Big blind = 0
(AggressorChair == bigblindchair) ? 0 :
// Small blind = 1
(AggressorChair == smallblindchair) ? 1 :
// Normal players:
// Button = 2, CutOff = 3, ...
(nplayersdealt - DealPositionLastRaiser + 2)

##EarlyPosition1ColdCalling##
// Called preflop and did not raise preflop (a caller of the first orbit)
(((callbits_preflop >> ep1chair) & 1) == 1) AND (((raisbits_preflop >> ep1chair) & 1) == 0)

##EarlyPosition2ColdCalling##
// Called preflop and did not raise preflop (a caller of the first orbit)
(((callbits_preflop >> ep2chair) & 1) == 1) AND (((raisbits_preflop >> ep2chair) & 1) == 0)

##EarlyPosition3ColdCalling##
// Called preflop and did not raise preflop (a caller of the first orbit)
(((callbits_preflop >> ep3chair) & 1) == 1) AND (((raisbits_preflop >> ep3chair) & 1) == 0)

##MiddlePosition1ColdCalling##
// Called preflop and did not raise preflop (a caller of the first orbit)
(((callbits_preflop >> mp1chair) & 1) == 1) AND (((raisbits_preflop >> mp1chair) & 1) == 0)

##MiddlePosition2ColdCalling##
// Called preflop and did not raise preflop (a caller of the first orbit)
(((callbits_preflop >> mp2chair) & 1) == 1) AND (((raisbits_preflop >> mp2chair) & 1) == 0)

##MiddlePosition3ColdCalling##
// Called preflop and did not raise preflop (a caller of the first orbit)
(((callbits_preflop >> mp3chair) & 1) == 1) AND (((raisbits_preflop >> mp3chair) & 1) == 0)

##CutOffColdCalling##
// Called preflop and did not raise preflop (a caller of the first orbit)
(((callbits_preflop >> cutoffchair) & 1) == 1) AND (((raisbits_preflop >> cutoffchair) & 1) == 0)

##ButtonColdCalling##
// Called preflop and did not raise preflop (a caller of the first orbit)
(((callbits_preflop >> buttonchair) & 1) == 1) AND (((raisbits_preflop >> buttonchair) & 1) == 0)

##SmallBlindColdCalling##
// Called preflop and did not raise preflop (a caller of the first orbit)
(((callbits_preflop >> smallblindchair) & 1) == 1) AND (((raisbits_preflop >> smallblindchair) & 1) == 0)

##BigBlindColdCalling##
// Called preflop and did not raise preflop (a caller of the first orbit)
(((callbits_preflop >> bigblindchair) & 1) == 1) AND (((raisbits_preflop >> bigblindchair) & 1) == 0)
