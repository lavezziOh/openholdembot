//*****************************************************************************
//
// OpenPPL - BettingAction Symbols
//
//*****************************************************************************

##AggressorChair##
// raischair (formerly ac_aggressor) alone is somewhat unreliable, as it gets scraped (by bets).
// But if we raise and there are super-fast calls behind us (e.g. at PokerAcademy),
// then we don't have stable frames and soon we will switch to the next betting round.
// (There are however no problems, if somebody else raises,
// because we always get stable frames at out turn.)
// So we also check for our last action and the amount to call.
// (-1 = fold 0 = check 1 = call 2 = raise e3 = betsize 4 = allin)
(((prevaction ==  2) OR (prevaction == 3)) AND (AmountToCall == 0)) ? userchair :
raischair

##BigBlindSittingOut##
(bigblindchair < 0) ? ERROR_bigblindchair_Not_Recognized__Check_Your_TableMap :
((playersactivebits >> bigblindchair & 1) == 0)

##SmallBlindSittingOut##
// No error if smallblind chair is unknown, it may be nissing.
(smallblindchair < 0) ? false :
((playersactivebits >> smallblindchair & 1) == 0)

##OpponentsLeftSittingOut##
(opponentsactivebits & opponentsplayingbits) == 0

##BotCalledBeforeFlop##
   (sitename$openholdem ? HINT_Counting_Only_Autoplayer_Actions_Not_Manual_User_Actions : false)
OR didcallround_preflop

##BotCalledOnFlop##
   (sitename$openholdem ? HINT_Counting_Only_Autoplayer_Actions_Not_Manual_User_Actions : false)
OR didcallround_flop

##BotCalledOnTurn##
   (sitename$openholdem ? HINT_Counting_Only_Autoplayer_Actions_Not_Manual_User_Actions : false)
OR (didcallround_turn > 0)

##BotCalledOnRiver##
   (sitename$openholdem ? HINT_Counting_Only_Autoplayer_Actions_Not_Manual_User_Actions : false)
OR didcallround_river

##BotCheckedPreflop##
   (sitename$openholdem ? HINT_Counting_Only_Autoplayer_Actions_Not_Manual_User_Actions : false)
OR didchecround_preflop

##BotCheckedOnFlop##
   (sitename$openholdem ? HINT_Counting_Only_Autoplayer_Actions_Not_Manual_User_Actions : false)
OR didchecround_flop

##BotCheckedOnTurn##
   (sitename$openholdem ? HINT_Counting_Only_Autoplayer_Actions_Not_Manual_User_Actions : false)
OR didchecround_turn

##BotCheckedOnRiver##
   (sitename$openholdem ? HINT_Counting_Only_Autoplayer_Actions_Not_Manual_User_Actions : false)
OR didchecround_river

##BotIsLastRaiser##
(AggressorChair==userchair)

##BotRaisedBeforeFlop##
   (sitename$openholdem ? HINT_Counting_Only_Autoplayer_Actions_Not_Manual_User_Actions : false)
OR (didraisround_preflop > 0)
OR (didbetsizeround_preflop > 0)

##BotRaisedOnFlop##
   (sitename$openholdem ? HINT_Counting_Only_Autoplayer_Actions_Not_Manual_User_Actions : false)
OR (didraisround_flop > 0)
OR (didbetsizeround_flop > 0)

##BotRaisedOnTurn##
   (sitename$openholdem ? HINT_Counting_Only_Autoplayer_Actions_Not_Manual_User_Actions : false)
OR didraisround_turn 
OR didbetsizeround_turn

##BotsActionsOnFlop##
WHEN IsFlop RETURN BotsActionsOnThisRound FORCE
WHEN Others RETURN
  ((sitename$openholdem ? HINT_Counting_Only_Autoplayer_Actions_Not_Manual_User_Actions : 0)
  // Checks are not counted
  + didcallround_flop 
  + didraisround_flop 
  + didbetsizeround_flop) FORCE

##BotsActionsOnTurn##
WHEN IsTurn RETURN BotsActionsOnThisRound FORCE
WHEN Others RETURN
  ((sitename$openholdem ? HINT_Counting_Only_Autoplayer_Actions_Not_Manual_User_Actions : 0)
  // Checks are not counted
  + didcallround_turn 
  + didraisround_turn 
  + didbetsizeround_turn) FORCE
  
##ActionCounterCorrectionForUpdateInProgress##
// If we update OpenPPL memory symbols after an autoplayer-action
// then OpenHoldems autoplayer-symbols already are updated
// and the sum of actions is "one ahead" 
// (compared to the situation when we took a decision)
// That's why we need a correction
WHEN me_re_MemUpdateOfOpenPPLMemorySymbolsInProgress RETURN -1 FORCE
WHEN Others RETURN 0 FORCE

##BotsActionsOnThisRound##
// Special condition to ease simulations at Manualmode 
// without the need for hand-resets
WHEN (IsPreflop AND (currentbet < bblind)) RETURN 0 FORCE
WHEN ((betround > preflop) AND (currentbet == 0)) RETURN 0 FORCE
WHEN (BotsActionsOnThisRoundAdapted < 0) RETURN 0 FORCE
WHEN Others RETURN BotsActionsOnThisRoundAdapted FORCE
 
##BotsActionsOnThisRoundIncludingChecks##
// Special condition to ease simulations at Manualmode 
// without the need for hand-resets
WHEN (IsPreflop AND (currentbet < bblind)) RETURN 0 FORCE
WHEN (BotsActionsOnThisRoundIncludingChecksAdapted < 0) RETURN 0 FORCE
WHEN Others RETURN BotsActionsOnThisRoundIncludingChecksAdapted FORCE

##BotsActionsOnThisRoundAdapted##
[(sitename$openholdem ? HINT_Counting_Only_Autoplayer_Actions_Not_Manual_User_Actions : 0)
// Checks are not counted per definition.
// Folds and allins are not relevant, as then the hand is over for us.
+ didcall 
+ didrais 
+ didbetsize
+ ActionCounterCorrectionForUpdateInProgress]
   
##BotsActionsOnThisRoundIncludingChecksAdapted##
[(sitename$openholdem ? HINT_Counting_Only_Autoplayer_Actions_Not_Manual_User_Actions : 0)
// Folds and allins are not relevant, as then the hand is over for us.
+ didchec 
+ didcall 
+ didbetsize 
+ didrais
+ ActionCounterCorrectionForUpdateInProgress]

##BotsActionsPreflop##
WHEN IsPreflop RETURN BotsActionsOnThisRound FORCE
WHEN Others RETURN
  ((sitename$openholdem ? HINT_Counting_Only_Autoplayer_Actions_Not_Manual_User_Actions : 0)
  // Checks are not counted per definition
  // and we can't check preflop without posting a blind out of order (first hand only).
  + didcallround_preflop 
  + didraisround_preflop 
  + didbetsizeround_preflop) FORCE

##CallsBeforeOurFirstAction##
WHEN (BotsActionsOnThisRoundIncludingChecks > 0) RETURN 0 FORCE
// Preflop with a raise: the limpers (and a completing small blind) called too
WHEN (IsPreflop AND (currentbet_lastraiserchair > bblind)) RETURN (nopponentscalling + LimpersBeforeTheRaise + CallersOfEarlierRaises) FORCE
WHEN (currentbet_lastraiserchair > 0) RETURN (nopponentscalling + CallersOfEarlierRaises) FORCE
WHEN Others RETURN nopponentscalling FORCE

##CallsLevelFloor##
// Bets above this level are bets or raises (preflop: the big blind)
WHEN IsPreflop RETURN bblind FORCE
WHEN Others RETURN 0 FORCE

##CallersOfEarlierRaises##
// Callers of a bet or raise that got re-raised before our first action
// (at every bet level below the highest one: players at that level minus the raiser).
  PlayersAtEarlierRaiseLevels - EarlierRaiseLevels

##PlayersAtEarlierRaiseLevels##
  (((currentbet0 > CallsLevelFloor) AND (currentbet0 < currentbet_lastraiserchair)) ? 1 : 0)
+ (((currentbet1 > CallsLevelFloor) AND (currentbet1 < currentbet_lastraiserchair)) ? 1 : 0)
+ (((currentbet2 > CallsLevelFloor) AND (currentbet2 < currentbet_lastraiserchair)) ? 1 : 0)
+ (((currentbet3 > CallsLevelFloor) AND (currentbet3 < currentbet_lastraiserchair)) ? 1 : 0)
+ (((currentbet4 > CallsLevelFloor) AND (currentbet4 < currentbet_lastraiserchair)) ? 1 : 0)
+ (((currentbet5 > CallsLevelFloor) AND (currentbet5 < currentbet_lastraiserchair)) ? 1 : 0)
+ (((currentbet6 > CallsLevelFloor) AND (currentbet6 < currentbet_lastraiserchair)) ? 1 : 0)
+ (((currentbet7 > CallsLevelFloor) AND (currentbet7 < currentbet_lastraiserchair)) ? 1 : 0)
+ (((currentbet8 > CallsLevelFloor) AND (currentbet8 < currentbet_lastraiserchair)) ? 1 : 0)
+ (((currentbet9 > CallsLevelFloor) AND (currentbet9 < currentbet_lastraiserchair)) ? 1 : 0)

##EarlierRaiseLevels##
  (((currentbet0 > CallsLevelFloor) AND (currentbet0 < currentbet_lastraiserchair)) ? 1 : 0)
+ (((currentbet1 > CallsLevelFloor) AND (currentbet1 < currentbet_lastraiserchair) AND (currentbet0 != currentbet1)) ? 1 : 0)
+ (((currentbet2 > CallsLevelFloor) AND (currentbet2 < currentbet_lastraiserchair) AND (currentbet0 != currentbet2) AND (currentbet1 != currentbet2)) ? 1 : 0)
+ (((currentbet3 > CallsLevelFloor) AND (currentbet3 < currentbet_lastraiserchair) AND (currentbet0 != currentbet3) AND (currentbet1 != currentbet3) AND (currentbet2 != currentbet3)) ? 1 : 0)
+ (((currentbet4 > CallsLevelFloor) AND (currentbet4 < currentbet_lastraiserchair) AND (currentbet0 != currentbet4) AND (currentbet1 != currentbet4) AND (currentbet2 != currentbet4) AND (currentbet3 != currentbet4)) ? 1 : 0)
+ (((currentbet5 > CallsLevelFloor) AND (currentbet5 < currentbet_lastraiserchair) AND (currentbet0 != currentbet5) AND (currentbet1 != currentbet5) AND (currentbet2 != currentbet5) AND (currentbet3 != currentbet5) AND (currentbet4 != currentbet5)) ? 1 : 0)
+ (((currentbet6 > CallsLevelFloor) AND (currentbet6 < currentbet_lastraiserchair) AND (currentbet0 != currentbet6) AND (currentbet1 != currentbet6) AND (currentbet2 != currentbet6) AND (currentbet3 != currentbet6) AND (currentbet4 != currentbet6) AND (currentbet5 != currentbet6)) ? 1 : 0)
+ (((currentbet7 > CallsLevelFloor) AND (currentbet7 < currentbet_lastraiserchair) AND (currentbet0 != currentbet7) AND (currentbet1 != currentbet7) AND (currentbet2 != currentbet7) AND (currentbet3 != currentbet7) AND (currentbet4 != currentbet7) AND (currentbet5 != currentbet7) AND (currentbet6 != currentbet7)) ? 1 : 0)
+ (((currentbet8 > CallsLevelFloor) AND (currentbet8 < currentbet_lastraiserchair) AND (currentbet0 != currentbet8) AND (currentbet1 != currentbet8) AND (currentbet2 != currentbet8) AND (currentbet3 != currentbet8) AND (currentbet4 != currentbet8) AND (currentbet5 != currentbet8) AND (currentbet6 != currentbet8) AND (currentbet7 != currentbet8)) ? 1 : 0)
+ (((currentbet9 > CallsLevelFloor) AND (currentbet9 < currentbet_lastraiserchair) AND (currentbet0 != currentbet9) AND (currentbet1 != currentbet9) AND (currentbet2 != currentbet9) AND (currentbet3 != currentbet9) AND (currentbet4 != currentbet9) AND (currentbet5 != currentbet9) AND (currentbet6 != currentbet9) AND (currentbet7 != currentbet9) AND (currentbet8 != currentbet9)) ? 1 : 0)

##LimpersBeforeTheRaise##
// Opponents (not the big blind) whose bet is exactly one big blind while there is a raise:
// they limped (or completed the small blind) before the raise and did not act on it yet.
  ((userchair != 0) AND (bigblindchair != 0) AND (currentbet0 == bblind) ? 1 : 0)
+ ((userchair != 1) AND (bigblindchair != 1) AND (currentbet1 == bblind) ? 1 : 0)
+ ((userchair != 2) AND (bigblindchair != 2) AND (currentbet2 == bblind) ? 1 : 0)
+ ((userchair != 3) AND (bigblindchair != 3) AND (currentbet3 == bblind) ? 1 : 0)
+ ((userchair != 4) AND (bigblindchair != 4) AND (currentbet4 == bblind) ? 1 : 0)
+ ((userchair != 5) AND (bigblindchair != 5) AND (currentbet5 == bblind) ? 1 : 0)
+ ((userchair != 6) AND (bigblindchair != 6) AND (currentbet6 == bblind) ? 1 : 0)
+ ((userchair != 7) AND (bigblindchair != 7) AND (currentbet7 == bblind) ? 1 : 0)
+ ((userchair != 8) AND (bigblindchair != 8) AND (currentbet8 == bblind) ? 1 : 0)
+ ((userchair != 9) AND (bigblindchair != 9) AND (currentbet9 == bblind) ? 1 : 0)

##CallsSinceLastPlay##
WHEN (BotsActionsOnThisRoundIncludingChecks == 0) RETURN 0 FORCE
// Re-raised after our action: count also the calls made before the re-raise
WHEN (currentbet_lastraiserchair > currentbet) RETURN (nopponentscalling + CallersOfOurRaiseBeforeTheReraise + CallersOfRaisesAfterOurAction) FORCE
WHEN Others RETURN nopponentscalling FORCE

##CallersOfOurRaiseBeforeTheReraise##
// Opponents who matched our bet or raise (prevaction 2 = raise, 3 = betsize) and did not act again yet
WHEN ((prevaction == 2) OR (prevaction == 3)) RETURN SqueezeColdCallersOfOurBet FORCE
WHEN Others RETURN 0 FORCE

##CallersOfRaisesAfterOurAction##
// Bet levels between ours and the highest one: players at that level minus the raiser
  PlayersBetweenOurBetAndTheRaise - LevelsBetweenOurBetAndTheRaise

##PlayersBetweenOurBetAndTheRaise##
  (((currentbet0 > currentbet) AND (currentbet0 < currentbet_lastraiserchair)) ? 1 : 0)
+ (((currentbet1 > currentbet) AND (currentbet1 < currentbet_lastraiserchair)) ? 1 : 0)
+ (((currentbet2 > currentbet) AND (currentbet2 < currentbet_lastraiserchair)) ? 1 : 0)
+ (((currentbet3 > currentbet) AND (currentbet3 < currentbet_lastraiserchair)) ? 1 : 0)
+ (((currentbet4 > currentbet) AND (currentbet4 < currentbet_lastraiserchair)) ? 1 : 0)
+ (((currentbet5 > currentbet) AND (currentbet5 < currentbet_lastraiserchair)) ? 1 : 0)
+ (((currentbet6 > currentbet) AND (currentbet6 < currentbet_lastraiserchair)) ? 1 : 0)
+ (((currentbet7 > currentbet) AND (currentbet7 < currentbet_lastraiserchair)) ? 1 : 0)
+ (((currentbet8 > currentbet) AND (currentbet8 < currentbet_lastraiserchair)) ? 1 : 0)
+ (((currentbet9 > currentbet) AND (currentbet9 < currentbet_lastraiserchair)) ? 1 : 0)

##LevelsBetweenOurBetAndTheRaise##
  (((currentbet0 > currentbet) AND (currentbet0 < currentbet_lastraiserchair)) ? 1 : 0)
+ (((currentbet1 > currentbet) AND (currentbet1 < currentbet_lastraiserchair) AND (currentbet0 != currentbet1)) ? 1 : 0)
+ (((currentbet2 > currentbet) AND (currentbet2 < currentbet_lastraiserchair) AND (currentbet0 != currentbet2) AND (currentbet1 != currentbet2)) ? 1 : 0)
+ (((currentbet3 > currentbet) AND (currentbet3 < currentbet_lastraiserchair) AND (currentbet0 != currentbet3) AND (currentbet1 != currentbet3) AND (currentbet2 != currentbet3)) ? 1 : 0)
+ (((currentbet4 > currentbet) AND (currentbet4 < currentbet_lastraiserchair) AND (currentbet0 != currentbet4) AND (currentbet1 != currentbet4) AND (currentbet2 != currentbet4) AND (currentbet3 != currentbet4)) ? 1 : 0)
+ (((currentbet5 > currentbet) AND (currentbet5 < currentbet_lastraiserchair) AND (currentbet0 != currentbet5) AND (currentbet1 != currentbet5) AND (currentbet2 != currentbet5) AND (currentbet3 != currentbet5) AND (currentbet4 != currentbet5)) ? 1 : 0)
+ (((currentbet6 > currentbet) AND (currentbet6 < currentbet_lastraiserchair) AND (currentbet0 != currentbet6) AND (currentbet1 != currentbet6) AND (currentbet2 != currentbet6) AND (currentbet3 != currentbet6) AND (currentbet4 != currentbet6) AND (currentbet5 != currentbet6)) ? 1 : 0)
+ (((currentbet7 > currentbet) AND (currentbet7 < currentbet_lastraiserchair) AND (currentbet0 != currentbet7) AND (currentbet1 != currentbet7) AND (currentbet2 != currentbet7) AND (currentbet3 != currentbet7) AND (currentbet4 != currentbet7) AND (currentbet5 != currentbet7) AND (currentbet6 != currentbet7)) ? 1 : 0)
+ (((currentbet8 > currentbet) AND (currentbet8 < currentbet_lastraiserchair) AND (currentbet0 != currentbet8) AND (currentbet1 != currentbet8) AND (currentbet2 != currentbet8) AND (currentbet3 != currentbet8) AND (currentbet4 != currentbet8) AND (currentbet5 != currentbet8) AND (currentbet6 != currentbet8) AND (currentbet7 != currentbet8)) ? 1 : 0)
+ (((currentbet9 > currentbet) AND (currentbet9 < currentbet_lastraiserchair) AND (currentbet0 != currentbet9) AND (currentbet1 != currentbet9) AND (currentbet2 != currentbet9) AND (currentbet3 != currentbet9) AND (currentbet4 != currentbet9) AND (currentbet5 != currentbet9) AND (currentbet6 != currentbet9) AND (currentbet7 != currentbet9) AND (currentbet8 != currentbet9)) ? 1 : 0)

##CallsSinceLastRaise##
WHEN (PlayersRaisingOrColdCallingTheLastRaise <= 0) RETURN HINT_There_Is_No_Raiser_Therefore_No_CallsSinceLastRaise FORCE
WHEN Others RETURN (PlayersRaisingOrColdCallingTheLastRaise - 1) FORCE

##Folds##
WHEN IsPreflop RETURN (nplayersdealt  - nopponentsplaying - 1) FORCE
WHEN IsFlop    RETURN (nplayersround_flop - nopponentsplaying - 1) FORCE
WHEN IsTurn    RETURN (nplayersround_turn - nopponentsplaying - 1) FORCE
WHEN IsRiver   RETURN (nplayersround_river - nopponentsplaying - 1) FORCE
WHEN Others RETURN ERROR_Betround_Out_Of_Range FORCE

##LastAggressorActsAfterUs##		
   ac_agchair_after 
AND NOT BotIsLastRaiser

##NoBettingOnFlop##
(nbetsround_flop == 0)
AND NOT didraisround_flop
AND NOT didbetsizeround_flop
AND NOT didalliround_flop

##NoBettingOnTurn##
(nbetsround_turn == 0)
AND NOT didraisround_turn
AND NOT didbetsizeround_turn
AND NOT didalliround_turn

##OpponentCalledOnFlop##
    (betround > flop)
AND ((didraisround_flop + didbetsizeround_flop) == 1)
AND NOT didchecround_flop
AND NOT didcallround_flop
AND NoVillainBetOrRaisedOnFlop

##OpponentCalledOnTurn##
    (betround > turn)
AND ((didraisround_turn + didbetsizeround_turn) == 1)
AND NOT didchecround_turn
AND NOT didcallround_turn
AND NoVillainBetOrRaisedOnTurn

##RaisesSinceLastPlay##
WHEN (BotsActionsOnThisRoundIncludingChecks == 0) RETURN RaisesBeforeOurFirstAction FORCE
WHEN (BotsActionsOnThisRoundIncludingChecks == 1) RETURN RaisesSinceLastPlayOnOurSecondAction FORCE
WHEN (BotsActionsOnThisRoundIncludingChecks >= 2) RETURN RaisesSinceLastPlayAfterOurSecondAction FORCE
WHEN Others RETURN ERROR_BotsActionsOnThisRound_Out_Of_Range FORCE

//*****************************************************************************
//
// Squeeze
//   squeeze = a 3-bet after an open raise and at least one cold call
//
//*****************************************************************************

##SqueezeOpportunity##
// Our first action preflop: exactly one raise and at least one call of it.
WHEN (NOT IsPreflop) RETURN false FORCE
WHEN (BotsActionsOnThisRoundIncludingChecks > 0) RETURN false FORCE
WHEN (RaisesBeforeOurFirstAction == 1) AND (CallsSinceLastRaise >= 1) RETURN true FORCE
WHEN Others RETURN false FORCE

##SqueezeSize##
// Raise-to amount (big blinds) of a squeeze: 3 times the open raise, plus 1 time per caller,
// plus 1 time out of position (from the blinds). 0 if there is no squeeze opportunity.
WHEN (NOT SqueezeOpportunity) RETURN 0 FORCE
WHEN Others RETURN ((currentbet_lastraiserchair / bblind) * (3 + CallsSinceLastRaise + (InTheBlinds ? 1 : 0))) FORCE

##SqueezeFoldChanceOpener##
// PokerTracker "fold to squeeze as raiser" of the open raiser; population value without data.
WHEN (pt_fold_to_squeeze_as_raiser_lastraiserchair >= 0) RETURN pt_fold_to_squeeze_as_raiser_lastraiserchair FORCE
WHEN Others RETURN 0.60 FORCE

##SqueezeFoldChanceFirstCaller##
WHEN (pt_fold_to_squeeze_as_caller_firstcallerchair >= 0) RETURN pt_fold_to_squeeze_as_caller_firstcallerchair FORCE
WHEN Others RETURN 0.70 FORCE

##SqueezeFoldChanceLastCaller##
WHEN (pt_fold_to_squeeze_as_caller_lastcallerchair >= 0) RETURN pt_fold_to_squeeze_as_caller_lastcallerchair FORCE
WHEN Others RETURN 0.70 FORCE

##SqueezeFoldChance##
// Probability that everybody folds to our squeeze: the open raiser, the callers
// (first and last caller with their own statistics, the others 0.70 each)
// and the players still to act behind us (0.90 each). 0 if there is no squeeze opportunity.
WHEN (NOT SqueezeOpportunity) RETURN 0 FORCE
WHEN Others RETURN (SqueezeFoldChanceOpener
  * SqueezeFoldChanceFirstCaller
  * ((CallsSinceLastRaise >= 2) ? SqueezeFoldChanceLastCaller : 1)
  * ((CallsSinceLastRaise >= 3) ? 0.70 : 1)
  * ((CallsSinceLastRaise >= 4) ? 0.70 : 1)
  * ((CallsSinceLastRaise >= 5) ? 0.70 : 1)
  * ((StillToAct >= 1) ? 0.90 : 1)
  * ((StillToAct >= 2) ? 0.90 : 1)
  * ((StillToAct >= 3) ? 0.90 : 1)
  * ((StillToAct >= 4) ? 0.90 : 1)
  * ((StillToAct >= 5) ? 0.90 : 1)) FORCE

##SqueezeColdCallersOfOurBet##
// Opponents whose bet equals ours (they called our bet and did not act again yet).
  ((userchair != 0) AND (currentbet0 == currentbet) AND (currentbet > 0) ? 1 : 0)
+ ((userchair != 1) AND (currentbet1 == currentbet) AND (currentbet > 0) ? 1 : 0)
+ ((userchair != 2) AND (currentbet2 == currentbet) AND (currentbet > 0) ? 1 : 0)
+ ((userchair != 3) AND (currentbet3 == currentbet) AND (currentbet > 0) ? 1 : 0)
+ ((userchair != 4) AND (currentbet4 == currentbet) AND (currentbet > 0) ? 1 : 0)
+ ((userchair != 5) AND (currentbet5 == currentbet) AND (currentbet > 0) ? 1 : 0)
+ ((userchair != 6) AND (currentbet6 == currentbet) AND (currentbet > 0) ? 1 : 0)
+ ((userchair != 7) AND (currentbet7 == currentbet) AND (currentbet > 0) ? 1 : 0)
+ ((userchair != 8) AND (currentbet8 == currentbet) AND (currentbet > 0) ? 1 : 0)
+ ((userchair != 9) AND (currentbet9 == currentbet) AND (currentbet > 0) ? 1 : 0)

##SqueezeBetsBetweenBigBlindAndOurs##
// Opponents with a bet above the big blind but below ours (a raise we re-raised or called).
  ((userchair != 0) AND (currentbet0 > bblind) AND (currentbet0 < currentbet) ? 1 : 0)
+ ((userchair != 1) AND (currentbet1 > bblind) AND (currentbet1 < currentbet) ? 1 : 0)
+ ((userchair != 2) AND (currentbet2 > bblind) AND (currentbet2 < currentbet) ? 1 : 0)
+ ((userchair != 3) AND (currentbet3 > bblind) AND (currentbet3 < currentbet) ? 1 : 0)
+ ((userchair != 4) AND (currentbet4 > bblind) AND (currentbet4 < currentbet) ? 1 : 0)
+ ((userchair != 5) AND (currentbet5 > bblind) AND (currentbet5 < currentbet) ? 1 : 0)
+ ((userchair != 6) AND (currentbet6 > bblind) AND (currentbet6 < currentbet) ? 1 : 0)
+ ((userchair != 7) AND (currentbet7 > bblind) AND (currentbet7 < currentbet) ? 1 : 0)
+ ((userchair != 8) AND (currentbet8 > bblind) AND (currentbet8 < currentbet) ? 1 : 0)
+ ((userchair != 9) AND (currentbet9 > bblind) AND (currentbet9 < currentbet) ? 1 : 0)

##FacingSqueezeAsRaiser##
// We open-raised, at least one player cold-called, then somebody 3-bet.
WHEN (NOT IsPreflop) RETURN false FORCE
WHEN (BotsActionsOnThisRoundIncludingChecks != 1) RETURN false FORCE
WHEN (NOT BotRaisedBeforeFlop) RETURN false FORCE
WHEN (RaisesSinceLastPlay != 1) RETURN false FORCE
WHEN (SqueezeBetsBetweenBigBlindAndOurs > 0) RETURN false FORCE
WHEN (SqueezeColdCallersOfOurBet >= 1) RETURN true FORCE
WHEN Others RETURN false FORCE

##FacingSqueezeAsCaller##
// We cold-called an open raise, then somebody 3-bet.
WHEN (NOT IsPreflop) RETURN false FORCE
WHEN (BotsActionsOnThisRoundIncludingChecks != 1) RETURN false FORCE
WHEN (NOT BotCalledBeforeFlop) RETURN false FORCE
WHEN (currentbet <= bblind) RETURN false FORCE
WHEN (RaisesSinceLastPlay != 1) RETURN false FORCE
WHEN (SqueezeBetsBetweenBigBlindAndOurs > 0) RETURN false FORCE
WHEN Others RETURN true FORCE

##FacingSqueeze##
(FacingSqueezeAsRaiser OR FacingSqueezeAsCaller)
